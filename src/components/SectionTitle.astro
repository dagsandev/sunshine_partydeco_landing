---
type Props = {
  /** Small label shown between the two lines above the heading. */
  eyebrow: string;
  title: string;
  /** Fade the title in on load. */
  animate?: boolean;
};

const { eyebrow, title, animate = false } = Astro.props;
const animation = animate && "animate-fade-in-up animate-delay-400";
---

<div class="text-center">
  <p class:list={["flex items-center justify-center gap-4 text-sm leading-6 opacity-80", animation]}>
    <span class="h-[0.10rem] w-16 rounded-sm bg-gray-300" aria-hidden="true"></span>
    {eyebrow}
    <span class="h-[0.10rem] w-16 rounded-sm bg-gray-300" aria-hidden="true"></span>
  </p>
  <h2 class:list={["mt-6 mb-20 text-2xl font-bold text-balance md:text-4xl", animation]}>
    {title}
  </h2>
</div>
