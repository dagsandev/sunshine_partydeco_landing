---
type Props = {
  /** Small label shown above the heading. */
  eyebrow: string;
  title: string;
  /** Optional supporting line under the heading. */
  subtitle?: string;
};

const { eyebrow, title, subtitle } = Astro.props;
---

<div class="mx-auto mb-14 max-w-2xl text-center md:mb-16">
  <p class="text-xs font-medium tracking-[0.2em] text-rose-deep uppercase">
    {eyebrow}
  </p>
  <h2 class="mt-3 font-display text-3xl text-balance md:text-5xl">{title}</h2>
  {subtitle && <p class="mt-4 text-ink/70 md:text-lg">{subtitle}</p>}
</div>
