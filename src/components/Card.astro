---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  body?: string;
  hrefA: string;
  img: ImageMetadata;
  alt: string;
}

const { title, body, hrefA, img, alt } = Astro.props;
---

<div class="card">
  <div class="image-container">
    <Image src={img} alt={alt} width={350} height={310} loading="lazy" />
  </div>

  <div class="text-container">
    <h3>{title}</h3>
    {body && <p>{body}</p>}
  </div>

  <div class="mt-8 mb-2">
    <a href={hrefA} class="btn">Ver Galería</a>
  </div>
</div>

<style>
  .card {
    max-width: 350px;
    min-width: 250px;
    width: 100%;
    height: 430px;
    background-color: rgba(126, 128, 108, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.15);
    margin: 20px;
    border-radius: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    text-align: center;
  }

  .image-container {
    margin-bottom: 10px;
    height: 310px;
    overflow: hidden;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-in-out;
  }
  img:hover {
    transform: scale(1.05);
  }

  h3 {
    color: #000000;
    font-weight: 700;
    margin-bottom: 4px;
    font-size: larger;
  }

  .btn {
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 20px;
    padding: 8px 10px;
    background-color: rgb(255, 255, 255);
  }
  .btn:hover {
    background-color: rgba(248, 250, 145, 0.877);
  }
  .btn:active {
    background-color: rgba(153, 151, 56, 0.479);
  }
</style>
