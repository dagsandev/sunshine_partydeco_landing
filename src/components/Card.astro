---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  body?: string;
  hrefA: string;
  img: ImageMetadata;
  alt: string;
}

const { title, body, hrefA, img, alt } = Astro.props;
---

<a
  href={hrefA}
  class="group block w-full overflow-hidden rounded-2xl sm:rounded-3xl bg-white text-left ring-1 ring-ink/5 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose/15"
>
  <div class="aspect-[4/5] overflow-hidden">
    <Image
      src={img}
      alt={alt}
      width={480}
      height={600}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>

  <div class="flex items-center justify-between gap-3 p-3 sm:p-5">
    <div>
      <h3 class="font-display text-base leading-tight sm:text-xl">{title}</h3>
      {body && <p class="mt-1 text-sm text-ink/70">{body}</p>}
    </div>
    <span
      class="hidden h-10 w-10 shrink-0 items-center sm:flex justify-center rounded-full bg-blush transition group-hover:bg-ink group-hover:text-white"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</a>
