---
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import heroMain from "../assets/services/centrodemesa1.webp";
import heroSecondary from "../assets/services/candybar1.webp";

const links = [
  { href: "#about", label: "Nosotras" },
  { href: "#services", label: "Servicios" },
  { href: "#products", label: "Galería" },
  { href: "#faq", label: "Preguntas" },
  { href: "#contact", label: "Contacto" },
];
---

<header class="relative overflow-hidden bg-blush">
  <!-- Navbar -->
  <nav
    id="site-nav"
    class="navbar fixed inset-x-0 top-0 z-50 transition duration-300"
    aria-label="Principal"
  >
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between px-5 py-3">
      <a href="#" class="flex items-center gap-2.5" aria-label="Sunshine Party Deco, inicio">
        <img src="/logo-sunshine.png" width="48" height="48" class="h-11 w-auto" alt="" />
        <span class="font-display text-xl leading-none">
          Sunshine
          <span class="block font-sans text-[0.65rem] tracking-[0.3em] text-ink/60 uppercase">Party Deco</span>
        </span>
      </a>

      <div class="flex items-center gap-2 md:order-2">
        <Button href="#contact" size="sm">Cotizar</Button>

        <button
          id="menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full hover:bg-ink/5 md:hidden"
          aria-controls="navbar-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Abrir menú</span>
          <svg class="h-5 w-5" aria-hidden="true" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"></path>
          </svg>
        </button>
      </div>

      <div id="navbar-menu" class="hidden w-full md:order-1 md:block md:w-auto">
        <ul
          class="mt-3 flex flex-col gap-1 rounded-2xl bg-white p-3 shadow-lg md:mt-0 md:flex-row md:gap-8 md:bg-transparent md:p-0 md:shadow-none"
        >
          {
            links.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="block rounded-xl px-3 py-2 text-sm font-medium transition hover:bg-blush md:p-0 md:hover:bg-transparent md:hover:text-rose-deep"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <div
    class="mx-auto grid min-h-[100svh] max-w-6xl items-center gap-12 px-5 pt-28 pb-16 md:grid-cols-2 md:pt-24"
  >
    <div class="animate-fade-in-up">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white/70 px-4 py-1.5 text-sm font-medium"
      >
        <span class="h-2.5 w-2.5 rounded-full bg-sun ring-2 ring-sun/40" aria-hidden="true"></span>
        Papelería creativa · CABA
      </span>

      <h1 class="mt-6 font-display text-5xl leading-[1.05] text-balance md:text-7xl">
        Decoración artesanal para tu evento
      </h1>

      <p class="mt-6 max-w-md text-lg text-ink/75">
        Diseñamos cada detalle a mano para que el festejo sea único: toppers, centros de mesa,
        candy bar y mucho más.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="#about" size="lg">Conocenos</Button>
        <Button href="#products" variant="outline" size="lg">Ver trabajos</Button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md md:max-w-none">
      <div
        class="absolute -top-6 -right-4 h-24 w-24 rounded-full bg-sun/80 blur-sm md:h-32 md:w-32"
        aria-hidden="true"
      >
      </div>
      <Image
        src={heroMain}
        alt="Centro de mesa con mariposas y moños en tonos rosa y lila"
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 45vw, 90vw"
        loading="eager"
        fetchpriority="high"
        class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-2xl shadow-rose/25 md:ml-auto md:w-[85%]"
      />
      <Image
        src={heroSecondary}
        alt="Candy bar de princesas con cajitas y tubos de golosinas"
        widths={[240, 400]}
        sizes="(min-width: 768px) 18vw, 40vw"
        loading="eager"
        class="absolute -bottom-8 -left-2 aspect-square w-2/5 rounded-3xl border-[6px] border-white object-cover shadow-xl md:-left-6"
      />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("navbar-menu");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Give the fixed navbar a solid background once the page leaves the top.
  const nav = document.getElementById("site-nav");
  const updateNav = () => nav?.classList.toggle("scrolled", window.scrollY > 10);
  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();
</script>

<style>
  .navbar.scrolled {
    background-color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgb(17 17 17 / 0.06);
  }
</style>
