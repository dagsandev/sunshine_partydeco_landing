---
import { getImage } from "astro:assets";
import heroBg from "../assets/hero/main-img-background.webp";

const bgDesktop = await getImage({ src: heroBg, width: 1920, format: "webp", quality: 75 });
const bgMobile = await getImage({ src: heroBg, width: 900, format: "webp", quality: 70 });

const links = [
  { href: "#", label: "Inicio" },
  { href: "#about", label: "Nosotras" },
  { href: "#services", label: "Servicios" },
  { href: "#products", label: "Productos" },
  { href: "#contact", label: "Contacto" },
  { href: "#faq", label: "FAQ" },
];
---

<header
  class="headerContainer"
  style={`--bg-desktop: url(${bgDesktop.src}); --bg-mobile: url(${bgMobile.src});`}
>
  <!--Navbar-->
  <nav
    id="site-nav"
    class="navbar fixed top-0 inset-x-0 z-50 flex flex-wrap items-center justify-between px-4 py-3"
  >
    <a href="#" class="flex items-center gap-3 rounded-full">
      <img src="/logo-sunshine.png" width="56" height="56" class="h-12 md:h-14 w-auto" alt="" />
      <span
        class="flex flex-col items-center text-xl uppercase font-extrabold text-dark-primary animate-pulse-fade-in animate-delay-250"
        >Sunshine <span class="text-sm md:text-base">PartyDeco</span></span
      >
    </a>

    <div class="flex md:order-2 gap-3">
      <a class="btn-nav hidden sm:inline-block" href="#contact">Cotizar</a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm rounded-lg md:hidden hover:bg-black/10 focus:outline-hidden focus:ring-2 focus:ring-gray-900"
        aria-controls="navbar-cta"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
    </div>

    <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-cta">
      <ul
        class="flex flex-wrap flex-row font-medium p-2 md:p-0 mt-4 border border-gray-400 bg-white/80 md:bg-transparent rounded-lg md:space-x-8 md:mt-0 md:border-0 justify-center"
      >
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block py-2 px-3 md:p-0 transition ease-in-out hover:-translate-y-1 hover:scale-110 duration-300"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
  <!--End-->

  <div class="text-content-container px-4 md:pl-20">
    <div class="text-content">
      <h1 class="text-4xl font-bold">Decoración artesanal para tu evento</h1>
      <span
        class="inline-flex items-center rounded-md mt-2 bg-gray-50 px-2 py-1 text-base font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10"
        >Papelería Creativa</span
      >
    </div>

    <a class="cta-btn" href="#about">Conocenos</a>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("navbar-cta");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Give the fixed navbar a solid background once the page leaves the top.
  const nav = document.getElementById("site-nav");
  const updateNav = () => nav?.classList.toggle("scrolled", window.scrollY > 10);
  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();
</script>

<style>
  :root {
    --navbar-height: 80px;
  }

  .headerContainer {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background: var(--bg-mobile) no-repeat center / cover;
  }
  @media (min-width: 900px) {
    .headerContainer {
      background-image: var(--bg-desktop);
    }
  }
  .headerContainer::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to top, rgb(255, 255, 255), transparent);
    pointer-events: none;
  }

  .navbar {
    min-height: var(--navbar-height);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .navbar.scrolled {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .text-content-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    min-height: 100svh;
    padding-top: var(--navbar-height);
  }

  .cta-btn,
  .btn-nav {
    background-color: rgb(251, 255, 0);
    border: 1px solid rgba(0, 0, 0, 0.452);
    padding: 10px 40px;
    text-align: center;
    font-weight: bold;
  }
  .cta-btn {
    margin-top: 2rem;
    border-radius: 60px;
  }
  .btn-nav {
    border-radius: 0.5rem;
  }
  .cta-btn:hover,
  .btn-nav:hover {
    background-color: rgb(227, 231, 3);
  }
  .cta-btn:active,
  .btn-nav:active {
    background-color: rgb(184, 187, 2);
  }
</style>
