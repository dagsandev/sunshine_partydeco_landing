---
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";
import aboutPic from "../assets/about/about-pic.webp";
---

<section class="text-center py-20 px-4 w-full mx-auto" id="about">
  <SectionTitle eyebrow="Conocenos" title="Sobre nosotras" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <article class="flex items-center">
      <div>
        <p class="text-justify text-xl md:text-1xl text-pretty">
          Hola! <span class="font-bold"
            >Somos Sole y Flor de Sunshine PartyDeco</span
          >. Nos encantaría ser parte de tu evento y convertirlo en un momento
          único. Todos los trabajos que realizamos son personalizados. Pensamos
          juntas cada detalle <span class="font-bold"
            >para que el agasajado viva un día súper especial</span
          >. Por eso
          <span class="font-bold"
            >te invitamos a que completes el siguiente formulario</span
          >, donde ya le estás dando vida a todas esas ideas que están dando
          vueltas por tu cabeza.
        </p>

        <div class="flex justify-center m-12">
          <Button href="https://tinyurl.com/sunshine-pd-form" size="lg" class="mt-4">
            Completar Formulario
          </Button>
        </div>
      </div>
    </article>

    <article>
      <Image
        src={aboutPic}
        class="max-w-full h-auto object-cover object-center rounded-sm"
        alt="Mesa decorada para un festejo de cumpleaños"
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="lazy"
      />
    </article>
  </div>
</section>

