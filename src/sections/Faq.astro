---
import SectionTitle from "../components/SectionTitle.astro";

const faqs = [
  {
    q: "¿Trabajan todo tipo de eventos?",
    a: "Nuestra especialidad es la decoración de eventos infantiles. Pero te invitamos a que nos consultes por cualquier otro tipo de evento, y si está a nuestro alcance, ¡estaremos encantadas de trabajar con vos!",
  },
  {
    q: "¿Cuánto demoran en entregarme el pedido?",
    a: 'Entre 5 y 15 días, pero siempre dependerá de la cantidad de mercadería solicitada y los tiempos de producción. Para una respuesta precisa, te invitamos a que nos <a href="#contact" class="font-medium text-rose-deep underline underline-offset-2">contactes</a> para brindarte una atención personalizada.',
  },
  {
    q: "¿Cómo puedo abonar?",
    a: `<ul class="ps-5 mb-2 list-disc">
          <li>Efectivo</li>
          <li>Mercado Pago</li>
          <li>Transferencia bancaria</li>
        </ul>
        <p class="text-sm">Se solicita el 50% de seña para congelar el precio.</p>
        <p class="text-sm">El presupuesto tiene una validez de 7 días.</p>`,
  },
  {
    q: "¿Dónde estamos ubicadas?",
    a: "Nos encontramos en el barrio de Belgrano, CABA. Solo para retiro de mercadería con cita previa, sin excepción.",
  },
];
---

<section class="bg-blush-soft px-5 py-24 md:py-32" id="faq">
  <div class="mx-auto max-w-3xl">
    <SectionTitle eyebrow="Aclará tus dudas" title="Preguntas frecuentes" />

    <div class="space-y-3">
      {
        faqs.map(({ q, a }, i) => (
          <details class="group rounded-2xl bg-white ring-1 ring-ink/5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 md:p-6">
              <h3 class="font-medium md:text-lg">{q}</h3>
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blush transition group-open:rotate-45 group-open:bg-ink group-open:text-white"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-6 leading-relaxed text-ink/75 md:px-6" set:html={a} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
