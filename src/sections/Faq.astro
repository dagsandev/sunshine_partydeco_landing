---
const faqs = [
  {
    q: "¿Trabajan todo tipo de eventos?",
    a: "Nuestra especialidad es la decoración de eventos infantiles. Pero te invitamos a que nos consultes por cualquier otro tipo de evento, y si está a nuestro alcance, ¡estaremos encantadas de trabajar con vos!",
  },
  {
    q: "¿Cuánto demoran en entregarme el pedido?",
    a: 'Entre 5 y 15 días, pero siempre dependerá de la cantidad de mercadería solicitada y los tiempos de producción. Para una respuesta precisa, te invitamos a que nos <a href="#contact" class="text-blue-600 underline">contactes</a> para brindarte una atención personalizada.',
  },
  {
    q: "¿Cómo puedo abonar?",
    a: `<ul class="ps-5 mb-2 list-disc">
          <li>Efectivo</li>
          <li>Mercado Pago</li>
          <li>Transferencia bancaria</li>
        </ul>
        <p class="text-sm">Se solicita el 50% de seña para congelar el precio.</p>
        <p class="text-sm">El presupuesto tiene una validez de 7 días.</p>`,
  },
  {
    q: "¿Dónde estamos ubicadas?",
    a: "Nos encontramos en el barrio de Belgrano, CABA. Solo para retiro de mercadería con cita previa, sin excepción.",
  },
];
---

<section class="w-full max-w-4xl mx-auto py-20 px-4" id="faq">
  <div class="text-center">
    <div class="inline-flex items-center justify-center w-full">
      <hr class="inline-block w-56 h-[0.10rem] bg-gray-300 border-0 rounded" />
      <div class="absolute px-4 -translate-x-1/2 bg-[#FFFFEC] left-1/2">
        <span class="inline-block text-sm opacity-80">Aclará tus dudas</span>
      </div>
    </div>
  </div>

  <h2 class="text-2xl md:text-4xl font-bold mt-6 mb-20 text-center text-balance">
    Preguntas Frecuentes
  </h2>

  <div class="m-2 border border-gray-200 rounded-xl divide-y divide-gray-200 overflow-hidden">
    {
      faqs.map(({ q, a }, i) => (
        <details class="group" open={i === 0}>
          <summary class="flex items-center justify-between w-full p-5 font-medium text-black cursor-pointer list-none hover:bg-gray-100 gap-3">
            <h3>{q}</h3>
            <svg
              class="w-3 h-3 shrink-0 transition-transform group-open:rotate-180"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 10 6"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 1 4 4 4-4"
              />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-black" set:html={a} />
        </details>
      ))
    }
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
