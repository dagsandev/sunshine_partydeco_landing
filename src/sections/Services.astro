---
import Card from "../components/Card.astro";
import SectionTitle from "../components/SectionTitle.astro";
import numeros3d from "../assets/services/numeros3d-1.webp";
import topper from "../assets/services/topper1.webp";
import cakeTopper from "../assets/services/CakeTopper3.webp";
import centroDeMesa from "../assets/services/centrodemesa1.webp";
import letras3d from "../assets/services/Letras3D-3.webp";
import souvenirIman from "../assets/services/souvenir-iman.webp";
import stickers from "../assets/services/stickers1.webp";
import tarjeteria from "../assets/services/tarjeteria1.webp";
import candyBar from "../assets/services/candybar1.webp";

const services = [
  { title: "Números 3D", img: numeros3d },
  { title: "Toppers", img: topper },
  { title: "Cake Toppers", img: cakeTopper },
  { title: "Centro de Mesa", img: centroDeMesa },
  { title: "Letras 3D", img: letras3d },
  { title: "Souvenir Imán", img: souvenirIman },
  { title: "Stickers", img: stickers },
  { title: "Tarjetería", img: tarjeteria },
  { title: "Candy Bar", img: candyBar },
];
---

<section class="bg-blush-soft px-5 py-24 md:py-32" id="services">
  <div class="mx-auto max-w-6xl">
    <SectionTitle
      eyebrow="Nuestro servicio"
      title="Papelería creativa para eventos"
      subtitle="Todo personalizado con la temática y los colores de tu festejo."
    />

    <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
      {
        services.map(({ title, img }) => (
          <Card
            title={title}
            hrefA="#products"
            img={img}
            alt={`${title} personalizados de Sunshine Party Deco`}
          />
        ))
      }
    </div>
  </div>
</section>
