---
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";

const inputClass =
  "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-yellow-400 focus:border-yellow-400 block w-full p-2.5";
---

<section class="text-center py-20 px-4 w-full mx-auto" id="contact">
  <SectionTitle eyebrow="Dónde encontrarnos" title="Contacto" />

  <div class="grid grid-cols-1 md:grid-cols-2 justify-center items-center">
    <div class="flex justify-center mx-auto w-full max-w-md">
      <form
        class="text-left rounded-md p-4 w-full"
        action="https://formspree.io/f/mdegpkrp"
        method="POST"
      >
        <div class="mb-6">
          <label for="name" class="block mb-2 text-sm font-medium">Nombre</label>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="name"
            required
            class={inputClass}
            placeholder="Alicia"
          />
        </div>

        <div class="mb-6">
          <label for="email" class="block mb-2 text-sm font-medium">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            required
            class={inputClass}
            placeholder="tu@email.com"
          />
        </div>

        <div class="mb-6">
          <label for="subject" class="block mb-2 text-sm font-medium">Asunto</label>
          <input
            type="text"
            name="subject"
            id="subject"
            required
            class={inputClass}
            placeholder="Presupuesto"
          />
        </div>

        <div class="mb-6">
          <label for="message" class="block mb-2 text-sm font-medium">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class={inputClass}
            placeholder="Hola, quiero información sobre su servicio..."
          ></textarea>
        </div>

        <!-- Formspree honeypot: hidden from humans, bots fill it in -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="flex justify-center">
          <Button type="submit" class="mt-4" data-submit>
            <span data-label>Enviar</span>
            <span data-loading class="hidden">Enviando…</span>
          </Button>
        </div>

        <p
          data-status
          class="hidden mt-4 rounded-lg p-3 text-sm text-center"
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>

    <article class="grid justify-center w-8/12 mt-12 md:mt-0 mx-auto">
      <ul>
        <li>
          <a
            href="https://instagram.com/sunshine_partydeco"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 py-2 md:py-3 text-sm hover:underline"
          >
            <span class="icon-container">
              <img width="28" height="28" src="/icons/instagram.png" alt="" />
            </span>
            @sunshine_partydeco
          </a>
        </li>

        <li>
          <a
            href="mailto:sunshine.partydeco@gmail.com"
            class="flex items-center gap-2 py-2 md:py-3 text-sm hover:underline"
          >
            <span class="icon-container">
              <img width="28" height="28" src="/icons/mail.png" alt="" />
            </span>
            sunshine.partydeco@gmail.com
          </a>
        </li>
      </ul>

      <p>Nos encontramos en CABA.</p>
      <p class="text-sm">
        Solo para retiro de mercadería con cita previa, ¡contactanos!
      </p>
    </article>
  </div>
</section>

<script>
  // Submit to Formspree via fetch so the visitor stays on the page.
  const form = document.querySelector<HTMLFormElement>("#contact form");
  const button = form?.querySelector<HTMLButtonElement>("[data-submit]");
  const status = form?.querySelector<HTMLElement>("[data-status]");

  const showStatus = (ok: boolean, message: string) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden", "bg-green-100", "text-green-800", "bg-red-100", "text-red-800");
    status.classList.add(...(ok ? ["bg-green-100", "text-green-800"] : ["bg-red-100", "text-red-800"]));
  };

  const setLoading = (loading: boolean) => {
    if (!button) return;
    button.disabled = loading;
    button.querySelector("[data-label]")?.classList.toggle("hidden", loading);
    button.querySelector("[data-loading]")?.classList.toggle("hidden", !loading);
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setLoading(true);
    status?.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(`Formspree responded ${response.status}`);

      form.reset();
      showStatus(true, "¡Gracias! Recibimos tu mensaje y te respondemos a la brevedad.");
    } catch {
      showStatus(
        false,
        "No pudimos enviar tu mensaje. Probá de nuevo o escribinos a sunshine.partydeco@gmail.com.",
      );
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  form {
    background-color: rgba(126, 128, 108, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.15);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
  }

  .icon-container {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 0.5rem;
    background-color: rgba(31, 41, 55, 0.11);
  }
  a:hover .icon-container {
    background-color: rgba(31, 41, 55, 0.322);
  }
</style>
