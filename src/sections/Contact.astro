---
const inputClass =
  "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-yellow-400 focus:border-yellow-400 block w-full p-2.5";
---

<section class="text-center py-20 px-4 w-full mx-auto" id="contact">
  <div class="inline-flex items-center justify-center w-full">
    <hr class="inline-block w-56 h-[0.10rem] bg-gray-300 border-0 rounded" />
    <div class="absolute px-4 -translate-x-1/2 bg-[#FFFFEC] left-1/2">
      <span class="inline-block text-sm opacity-80">Donde Encontrarnos</span>
    </div>
  </div>

  <h2 class="text-2xl md:text-4xl font-bold mt-6 mb-20 text-balance">
    Contacto
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 justify-center items-center">
    <div class="flex justify-center mx-auto w-full max-w-md">
      <form
        class="text-left rounded-md p-4 w-full"
        action="https://formspree.io/f/xjvnornq"
        method="POST"
      >
        <div class="mb-6">
          <label for="name" class="block mb-2 text-sm font-medium">Nombre</label>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="name"
            required
            class={inputClass}
            placeholder="Alicia"
          />
        </div>

        <div class="mb-6">
          <label for="email" class="block mb-2 text-sm font-medium">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            required
            class={inputClass}
            placeholder="tu@email.com"
          />
        </div>

        <div class="mb-6">
          <label for="subject" class="block mb-2 text-sm font-medium">Asunto</label>
          <input
            type="text"
            name="subject"
            id="subject"
            required
            class={inputClass}
            placeholder="Presupuesto"
          />
        </div>

        <div class="mb-6">
          <label for="message" class="block mb-2 text-sm font-medium">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class={inputClass}
            placeholder="Hola, quiero información sobre su servicio..."
          ></textarea>
        </div>

        <!-- Honeypot anti-spam de Formspree: los humanos no lo ven -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="flex justify-center">
          <button class="formBtn" type="submit">Enviar</button>
        </div>
      </form>
    </div>

    <article class="grid justify-center w-8/12 mt-12 md:mt-0 mx-auto">
      <ul>
        <li>
          <a
            href="https://instagram.com/sunshine_partydeco"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 py-2 md:py-3 text-sm hover:underline"
          >
            <span class="icon-container">
              <img width="28" height="28" src="/icons/instagram.png" alt="" />
            </span>
            @sunshine_partydeco
          </a>
        </li>

        <li>
          <a
            href="mailto:sunshine.partydeco@gmail.com"
            class="flex items-center gap-2 py-2 md:py-3 text-sm hover:underline"
          >
            <span class="icon-container">
              <img width="28" height="28" src="/icons/mail.png" alt="" />
            </span>
            sunshine.partydeco@gmail.com
          </a>
        </li>
      </ul>

      <p>Nos encontramos en CABA.</p>
      <p class="text-sm">
        Solo para retiro de mercadería con cita previa, ¡contactanos!
      </p>
    </article>
  </div>
</section>

<style>
  form {
    background-color: rgba(126, 128, 108, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.15);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
  }

  .formBtn {
    margin-top: 1rem;
    background-color: rgb(251, 255, 0);
    border: 1px solid rgba(0, 0, 0, 0.452);
    border-radius: 0.5rem;
    padding: 10px 40px;
    font-weight: bold;
  }
  .formBtn:hover {
    background-color: rgb(227, 231, 3);
  }
  .formBtn:active {
    background-color: rgb(184, 187, 2);
  }

  .icon-container {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 0.5rem;
    background-color: rgba(31, 41, 55, 0.11);
  }
  a:hover .icon-container {
    background-color: rgba(31, 41, 55, 0.322);
  }
</style>
