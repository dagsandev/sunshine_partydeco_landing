---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CtaBtn from "../components/CtaBtn.astro";

const images = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*.png", {
    eager: true,
  }),
).map((mod) => mod.default);
---

<section class="text-center py-20 px-4 w-full mx-auto" id="products">
  <div class="inline-flex items-center justify-center w-full">
    <hr class="inline-block w-56 h-[0.10rem] bg-gray-300 border-0 rounded" />
    <div class="absolute px-4 -translate-x-1/2 bg-[#FFFFF3] left-1/2">
      <span class="inline-block text-sm opacity-80">Nuestros Productos</span>
    </div>
  </div>

  <h2 class="text-center text-2xl md:text-4xl font-bold mt-6 mb-20 text-balance">
    Galería
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
      images.map((img, i) => (
        <Image
          class="tag-img"
          src={img}
          alt={`Trabajo de decoración de Sunshine Party Deco ${i + 1}`}
          widths={[400, 600]}
          sizes="(min-width: 768px) 33vw, 100vw"
          loading="lazy"
        />
      ))
    }
  </div>

  <div class="flex justify-center mx-auto my-4 md:mt-20">
    <CtaBtn
      title="Visitar Instagram"
      hrefA="https://instagram.com/sunshine_partydeco"
    />
  </div>
</section>

<style>
  .tag-img {
    @apply w-full h-full object-cover object-center rounded-lg;
  }
</style>
