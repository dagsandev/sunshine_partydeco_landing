---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Decoración artesanal y papelería creativa para eventos infantiles en CABA. Toppers, números y letras 3D, centros de mesa, candy bar y más.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/logo-sunshine.png", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Sunshine Party Deco" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <link rel="author" href="https://dagsan.dev" />
    <link rel="icon" type="image/png" href="/logo-sunshine.png" />

    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LWLZMMMXGZ"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-LWLZMMMXGZ");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background: linear-gradient(
      0deg,
      rgba(243, 246, 197, 1) 0%,
      rgba(255, 255, 234, 1) 10%,
      rgba(255, 255, 255, 1) 100%
    );
    overflow-x: hidden;
    scroll-behavior: smooth;
    /* Keep anchored sections clear of the fixed navbar */
    scroll-padding-top: 80px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p {
    text-wrap: balance;
  }
</style>
